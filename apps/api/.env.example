DATABASE_URL="postgresql://user:password@localhost:5432/halalmap?schema=public"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
PORT=4000
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
CLIENT_ORIGIN_MOBILE="exp://"
CLIENT_ORIGIN_RESTAURANT="http://localhost:5173"
CLIENT_ORIGIN_ADMIN="http://localhost:5174"
# Pickup only when false; set true to enable delivery app-wide (default: true if unset)
ENABLE_DELIVERY="true"
# S3 for menu item image uploads (all four required for upload to work)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional: S3-compatible endpoint (e.g. Cloudflare R2, MinIO)
# S3_ENDPOINT=
# Optional: public URL base for stored objects (e.g. R2 public bucket URL). If unset, uses https://{bucket}.s3.{region}.amazonaws.com/{key}
# S3_PUBLIC_URL_BASE=
# Bucket (or objects under menu-items/*) must allow public read so images can be displayed. For browser uploads, configure CORS on the bucket to allow your dashboard origin and method PUT.
