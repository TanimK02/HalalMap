{
  "expo": {
    "name": "Halal Map",
    "slug": "halal-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.halalmap.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Halal Map uses your location to show nearby restaurants."
      }
    },
    "android": {
      "package": "com.halalmap.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "scheme": "halalmap"
  }
}
