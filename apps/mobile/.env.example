# Public API (Render). Use this so the app talks to the deployed backend — set the same in apps/mobile/.env
# for viewers, demos, or whenever you are not running the API on your machine.
EXPO_PUBLIC_API_URL=https://halalmap.onrender.com

# Local API instead (uncomment and comment out the line above):
# EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
# Physical device on same Wi‑Fi as your dev machine: http://YOUR_LAN_IP:4000
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
