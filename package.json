{
  "name": "halal-map",
  "private": true,
  "version": "0.1.0",
  "description": "Halal delivery marketplace MVP",
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:restaurant": "pnpm --filter restaurant-dashboard dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "dev:mobile:tunnel": "pnpm --filter mobile dev -- --tunnel",
    "build:api": "pnpm --filter api build",
    "build:restaurant": "pnpm --filter restaurant-dashboard build",
    "build:admin": "pnpm --filter admin build",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:push": "pnpm --filter api exec prisma db push",
    "db:seed": "pnpm --filter api exec prisma db seed",
    "db:studio": "pnpm --filter api exec prisma studio",
    "test:api": "pnpm --filter api test:run",
    "test:api:integration": "pnpm --filter api test:integration",
    "test:mobile": "pnpm --filter mobile test:run",
    "test:mobile:e2e": "pnpm --filter mobile test:e2e",
    "test:admin": "pnpm --filter admin test:run",
    "test:restaurant": "pnpm --filter restaurant-dashboard test:run",
    "test:shared": "pnpm --filter @halal-map/shared test:run",
    "test": "pnpm -r test:run"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20"
  }
}
